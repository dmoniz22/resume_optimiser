# Database
DATABASE_URL=postgresql+asyncpg://resume_user:resume_pass@postgres:5432/resume_optimizer
REDIS_URL=redis://valkey:6379/0

# Ollama Cloud (OpenAI-compatible API)
OLLAMA_CLOUD_API_KEY=your_ollama_cloud_key_here
OLLAMA_CLOUD_BASE_URL=https://ollama.cloud/api/v1
AI_MODEL_REWRITE=gemma4:31b
AI_MODEL_PARSE=deepseek-v4-flash
AI_MODEL_EXTRACT=ministral-3:14b
AI_MODEL_COVER_LETTER=gemma4:31b

# Local Ollama (for embeddings, runs in Docker Compose)
LOCAL_OLLAMA_URL=http://ollama:11434/v1
EMBEDDING_MODEL=nomic-embed-text

# Stripe (Canadian merchant)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_CAREER=price_...

# Auth
JWT_SECRET=generate_a_random_secret_here
NEXTAUTH_SECRET=generate_another_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Email
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@resume-optimizer.com

# Storage
UPLOAD_DIR=/data/resumes

# Internal API key (for cron agents)
INTERNAL_API_KEY=generate_yet_another_secret_here

# App URLs
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
DOMAIN=localhost
